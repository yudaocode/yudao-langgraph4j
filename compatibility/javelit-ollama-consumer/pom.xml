<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>
    <groupId>cn.iocoder.compat</groupId>
    <artifactId>javelit-ollama-consumer</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <properties>
        <undertow.version>2.2.41.Final</undertow.version>
        <java.version>8</java.version>
        <jackson-bom.version>2.21.4</jackson-bom.version>
        <httpclient5.version>5.6.5</httpclient5.version>
        <httpcore5.version>5.4.4</httpcore5.version>
        <reactor-bom.version>2024.0.18</reactor-bom.version>
        <maven.compiler.release>8</maven.compiler.release>
        <compat.test.jvm>${java.home}/bin/java</compat.test.jvm>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.iocoder.langgraph4j</groupId>
                <artifactId>langgraph4j-bom</artifactId>
                <version>1.9.10-jdk8-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>cn.iocoder.langgraph4j</groupId>
            <artifactId>langgraph4j-javelit</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langgraph4j</groupId>
            <artifactId>langgraph4j-langchain4j-agentexecutor</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <jvm>${compat.test.jvm}</jvm>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
